<policies>
  <inbound>
    <base />

    <set-variable
        name="isCursorDemoKey"
        value='@(context.Request.Headers.GetValueOrDefault("Authorization", "") == "Bearer {{cursor-demo-api-key}}")' />

    <choose>
      <when condition='@((bool)context.Variables["isCursorDemoKey"])'>
        <set-header name="X-AIGOV-Caller-Subject" exists-action="override">
          <value>app:cursor-demo</value>
        </set-header>

        <set-header name="X-AIGOV-Cost-Center" exists-action="override">
          <value>BUDGET-ALLOW</value>
        </set-header>

        <set-header name="X-AIGOV-Data-Classification" exists-action="override">
          <value>internal</value>
        </set-header>
      </when>

      <otherwise>
        <validate-azure-ad-token
            tenant-id="${tenant_id}"
            header-name="Authorization"
            failed-validation-httpcode="401"
            failed-validation-error-message="Unauthorized. A valid Microsoft Entra access token or Cursor demo API key is required."
            output-token-variable-name="validatedJwt">
          <client-application-ids>
            <application-id>${demo_client_id}</application-id>
          </client-application-ids>

          <audiences>
            <audience>${governance_api_client_id}</audience>
          </audiences>

          <required-claims>
            <claim name="scp" match="any" separator=" ">
              <value>access_as_user</value>
            </claim>
          </required-claims>
        </validate-azure-ad-token>

        <set-header name="X-AIGOV-Caller-Subject" exists-action="override">
          <value>@{
            var jwt = (Jwt)context.Variables["validatedJwt"];
            var oid = jwt.Claims.GetValueOrDefault("oid", "");
            return oid == "" ? "sub:" + jwt.Subject : "oid:" + oid;
          }</value>
        </set-header>

        <set-header name="X-AIGOV-Cost-Center" exists-action="override">
          <value>BUDGET-ALLOW</value>
        </set-header>

        <set-header name="X-AIGOV-Data-Classification" exists-action="override">
          <value>internal</value>
        </set-header>
      </otherwise>
    </choose>

    <authentication-managed-identity
        resource="${governance_api_client_id}"
        ignore-error="false" />
  </inbound>

  <backend>
    <base />
  </backend>

  <outbound>
    <base />
  </outbound>

  <on-error>
    <base />
  </on-error>
</policies>